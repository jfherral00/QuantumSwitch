# Integers must be written without '.'
# Numbers with '.' or in scientific notation will be interpreted as float
# Else: Exception, not allowed


[SimpleSwitch]
#Network topology
switching_table=[(1,2),(7,3)]
list_sw_table = [[(1,2)],[(1,2),(7,3)],[(1,2),(7,3),(14,17)],[(1,2),(7,3),(14,17),(5,15),(4,6)],[(1,2),(7,3),(14,17),(5,15),(4,6),(8,9),(10,11)],[(1,2),(7,3),(14,17),(5,15),(4,6),(8,9),(10,11),(12,16),(13,18),(19,20)],[(1,2),(7,3),(14,17),(5,15),(4,6),(8,9),(10,11),(12,16),(13,18),(19,20),(21,22),(23,30),(24,25),(26,27),(28,29)]]
num_leaves=30
list_distance = [1,5,10,25,50]
#Memory parameters
T1 = 1e9 #T1 time, dictating amplitude damping component for memories (nanoseconds)
T2 = 1e9 #T2 dephasing time for memories(nanoseconds)
#Quantum Processor
dephase_rate = 200 #Dephasing rate in gates (Hz)
list_instr = [100,1000,10000,15000,20000,25000,50000,100000,250000]
#Entanglement source
source_fidelity_sq = 1 #Fidelity of the source
#Depolarizing Channel
p_depol_init = 0.009 #Probability of depolarization on entering a fibre.
p_depol_length = 0.0025 #Probability of depolarization per km of fibre.
#Simulation
duration = 1e9 #Duration of simulation (nanoseconds)



